# Auto detect text files and normalize line endings to LF
* text=auto

# Python files
*.py text eol=lf

# Documentation
*.md text eol=lf
README text eol=lf
readme.md text eol=lf

# CSV files
*.csv text eol=lf

# JSON/YAML configuration
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.pdf binary
*.xlsx binary
*.xls binary

